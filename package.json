{
  "name": "odin-project-mini_message_board",
  "version": "1.0.0",
  "description": "A simple message board using Node.js, Express, EJS, with no data store.",
  "keywords": [
    "backend",
    "nodejs",
    "express",
    "ejs",
    "odin"
  ],
  "license": "ISC",
  "author": "attritionxd-oss",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node ./src/server.js",
    "dev": "node --watch ./src/server.js"
  },
  "dependencies": {
    "ejs": "^6.0.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "prettier-plugin-ejs": "^1.0.3"
  },
  "imports": {
    "#*": "./src/*",
    "#controllers/*": "./src/controllers/*",
    "#middleware/*": "./src/middleware/*",
    "#routes/*": "./src/routes/*",
    "#services/*": "./src/services/*"
  }
