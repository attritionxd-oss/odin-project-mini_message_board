{
  "name": "odin-project-mini_message_board",
  "version": "1.0.0",
  "description": "A simple message board using Node.js, Express, EJS, with no data store.",
  "keywords": [
    "backend",
    "nodejs",
    "express",
    "ejs",
    "odin"
  ],
  "license": "ISC",
  "author": "attritionxd-oss",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node ./src/server.js",
    "dev": "node --watch ./src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check"
  },
  "dependencies": {
    "ejs": "^6.0.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-node": "^11.1.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-ejs": "^1.0.3"
  },
  "imports": {
    "#*": "./src/*",
    "#controllers/*": "./src/controllers/*",
    "#middleware/*": "./src/middleware/*",
    "#routes/*": "./src/routes/*",
    "#services/*": "./src/services/*"
  }
}
