<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mini Message Board: <%= title %></title>
    <style>
      #root {
        color: #9ca3af;
        background-color: #16171d;
      }
    </style>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="icon" href="/favicon.png" type="image/png" />
  </head>
  <body id="root">
    <%- include("../partials/navbar") %>
    <main class="main__main-wrapper">
      <section class="view-message__wrapper">
        <div class="view-message__content-details-wrapper">
          <ul class="view-message__content-details">
            <li class="view-message__close-wrapper">
              <a
                href="/"
                aria-label="Close button: Return to All Messages"
                class="icon-link"
              >
                <button type="button" class="view-message__close">
                  <%- include("../partials/close-icon") %>
                </button>
              </a>
            </li>
            <li class="view-message__message-property">
              <span class="view-message__content-label">User</span>
              <span class="view-message__content"><%= message.user %></span>
            </li>
            <li class="view-message__message-property">
              <span class="view-message__content-label">Date sent</span>
              <span class="view-message__content"><%= message.added %></span>
            </li>
            <li class="view-message__message-property">
              <span class="view-message__content-label">Message</span>
              <textarea
                class="view-message__textarea"
                name="userMessage"
                placeholder="Message"
                autocorrect="on"
                spellcheck="true"
                wrap="soft"
                required="true"
                aria-label="Message input"
                form="edit-message-form"
              ><%= message.text %></textarea>
            </li>
          </ul>
          <div class="view-message__button-wrapper">
            <form
              id="edit-message-form"
              action="/<%= message.id %>/edit"
              method="post"
            >
              <button
                type="submit"
                class="view-message__button view-message__edit"
              >
                Edit
              </button>
            </form>
            <form action="/<%= message.id %>/delete" method="post">
              <button
                type="submit"
                class="view-message__button view-message__delete"
                onclick="
                  return confirm(
                    'Are you sure you want to delete this message?',
                  );
                "
              >
                Delete
              </button>
            </form>
          </div>
        </div>
      </section>
    </main>
    <%- include("../partials/footer")  %>
  </body>
</html>
